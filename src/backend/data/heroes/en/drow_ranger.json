  "talents_description": {
    "modifier_drow_ranger_1_0": "Frost Arrow Damage Increase: 10/20/30",
    "modifier_drow_ranger_1_1": "Frost Arrow Damage Increase: <b><font color='#eabe10'>10</font></b>/20/30",
    "modifier_drow_ranger_1_2": "Frost Arrow Damage Increase: 10/<b><font color='#eabe10'>20</font></b>/30",
    "modifier_drow_ranger_1_3": "Frost Arrow Damage Increase: 10/20/<b><font color='#eabe10'>30</font></b>",
    "modifier_drow_ranger_2_0": "Attack Speed: 15/30/45",
    "modifier_drow_ranger_2_1": "Attack Speed: <b><font color='#eabe10'>15</font></b>/30/45",
    "modifier_drow_ranger_2_2": "Attack Speed: 15/<b><font color='#eabe10'>30</font></b>/45",
    "modifier_drow_ranger_2_3": "Attack Speed: 15/30/<b><font color='#eabe10'>45</font></b>",
    "modifier_drow_ranger_3_0": "Frost Arrow Damage Increase: 10%/20% of Strength \n\n Frost Arrow spends Health, not Mana.",
    "modifier_drow_ranger_3_1": "Frost Arrow Damage Increase: <b><font color='#eabe10'>10%</font></b>/20% of Strength \n\n Frost Arrow spends <b><font color='#eabe10'>Health</font></b>, not Mana.",
    "modifier_drow_ranger_3_2": "Frost Arrow Damage Increase: 10%/<b><font color='#eabe10'>20%</font></b> of Strength \n\n Frost Arrow spends <b><font color='#eabe10'>Health</font></b>, not Mana.",
    "modifier_drow_ranger_4_0": "New Passive Ability: Hypothermia \n\n Frost Arrows apply stacks of Hypothermia, which reduce health restoration by 5%. If an enemy dies under the effect of Hypothermia, they will explode and deal Frost Arrow Magic Damage to all nearby enemies for each stack. \n\n Max stacks: 6",
    "modifier_drow_ranger_4_1": "New Passive Ability: <b><font color='#eabe10'>Hypothermia</font></b> \n\n Frost Arrows apply stacks of Hypothermia, which reduce health restoration by <b><font color='#eabe10'>5%</font></b>. If an enemy dies under the effect of Hypothermia, they will explode and deal Frost Arrow Magic Damage to all nearby enemies for each stack. \n\n Max stacks: <b><font color='#eabe10'>6</font></b>",
    "modifier_drow_ranger_5_0": "The hero's arrows split when they hit an enemy and hit a random nearby target for 50% damage. Each such arrow counts as a normal attack. \n\n Number of targets: 1/2",
    "modifier_drow_ranger_5_1": "The hero's arrows split when they hit an enemy and hit a random nearby target for 50% damage. Each such arrow counts as a normal attack. \n\n Number of targets: <b><font color='#eabe10'>1</font></b>/2",
    "modifier_drow_ranger_5_2": "The hero's arrows split when they hit an enemy and hit a random nearby target for 50% damage. Each such arrow counts as a normal attack. \n\n Number of targets: 1/<b><font color='#eabe10'>2</font></b>",
    "modifier_drow_ranger_6_0": "An explosion from Hypothermia occurs when the target gains maximum stacks. \n\n Explosion Damage Increase: 25%/50% of Strength",
    "modifier_drow_ranger_6_1": "An explosion from Hypothermia occurs when the target gains maximum stacks. \n\n Explosion Damage Increase: <b><font color='#eabe10'>25%</font></b>/50% of Strength",
    "modifier_drow_ranger_6_2": "An explosion from Hypothermia occurs when the target gains maximum stacks. \n\n Explosion Damage Increase: 25%/<b><font color='#eabe10'>50%</font></b> of Strength",
    "modifier_drow_ranger_7_0": "Precision Aura grants bonus Strength instead of Agility.",
    "modifier_drow_ranger_7_1": "Precision Aura grants bonus <b><font color='#eabe10'>Strength</font></b> instead of Agility.",
    "modifier_drow_ranger_8_0": "Agility: 5/10/15",
    "modifier_drow_ranger_8_1": "Agility: <b><font color='#eabe10'>5</font></b>/10/15",
    "modifier_drow_ranger_8_2": "Agility: 5/<b><font color='#eabe10'>10</font></b>/15",
    "modifier_drow_ranger_8_3": "Agility: 5/10/<b><font color='#eabe10'>15</font></b>",
