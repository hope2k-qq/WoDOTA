  "talents_description": {
    "modifier_vengeful_spirit_1_0": "Wave of Terror slows Movement Speed: 10%/20%",
    "modifier_vengeful_spirit_1_1": "Wave of Terror slows Movement Speed: <b><font color='#eabe10'>10%</font></b>/20%",
    "modifier_vengeful_spirit_1_2": "Wave of Terror slows Movement Speed: 10%/<b><font color='#eabe10'>20%</font></b>",
    "modifier_vengeful_spirit_2_0": "Base Damage: 10/20/30",
    "modifier_vengeful_spirit_2_1": "Base Damage: <b><font color='#eabe10'>10</font></b>/20/30",
    "modifier_vengeful_spirit_2_2": "Base Damage: 10/<b><font color='#eabe10'>20</font></b>/30",
    "modifier_vengeful_spirit_2_3": "Base Damage: 10/20/<b><font color='#eabe10'>30</font></b>",
    "modifier_vengeful_spirit_3_0": "When damage taken reaches a limit of 40% of your Max Health, you will automatically Nether Swap at a random location within a 600 Radius.",
    "modifier_vengeful_spirit_3_1": "When damage taken reaches a limit of <b><font color='#eabe10'>40%</font></b> of your Max Health, you will automatically <b><font color='#eabe10'>Nether Swap</font></b> at a random location within a 600 Radius.",
    "modifier_vengeful_spirit_4_0": "Applying Nether Swap restores Health and Mana: 4%/8%",
    "modifier_vengeful_spirit_4_1": "Applying Nether Swap restores Health and Mana: <b><font color='#eabe10'>4%</font></b>/8%",
    "modifier_vengeful_spirit_4_2": "Applying Nether Swap restores Health and Mana: 4%/<b><font color='#eabe10'>8%</font></b>",
    "modifier_vengeful_spirit_5_0": "Increases Vengeance Aura owner multiplier: 20%/40%",
    "modifier_vengeful_spirit_5_1": "Increases Vengeance Aura owner multiplier: <b><font color='#eabe10'>20%</font></b>/40%",
    "modifier_vengeful_spirit_5_2": "Increases Vengeance Aura owner multiplier: 20%/<b><font color='#eabe10'>40%</font></b>",
    "modifier_vengeful_spirit_6_0": "Increase Outgoing Damage of All Illusions: 15%/30%",
    "modifier_vengeful_spirit_6_1": "Increase Outgoing Damage of All Illusions: <b><font color='#eabe10'>15%</font></b>/30%",
    "modifier_vengeful_spirit_6_2": "Increase Outgoing Damage of All Illusions: 15%/<b><font color='#eabe10'>30%</font></b>",
    "modifier_vengeful_spirit_7_0": "When damage taken reaches a limit of 40% of your Max Health, you automatically create an Illusion at a random point in a 600 Radius. \n\n Illusion Damage: 50% \n Illusion Damage Taken: 200% \n Illusion Duration: 7 seconds",
    "modifier_vengeful_spirit_7_1": "When damage taken reaches a limit of <b><font color='#eabe10'>40%</font></b> of your Max Health, you automatically create an <b><font color='#eabe10'>Illusion</font></b> at a random point in a 600 Radius. \n\n Illusion Damage: <b><font color='#eabe10'>50%</font></b> \n Illusion Damage Taken: 200% \n Illusion Duration: 7 seconds",
    "modifier_vengeful_spirit_8_0": "Increases Wave of Terror Armor Reduction: 1/2/3",
    "modifier_vengeful_spirit_8_1": "Increases Wave of Terror Armor Reduction: <b><font color='#eabe10'>1</font></b>/2/3",
    "modifier_vengeful_spirit_8_2": "Increases Wave of Terror Armor Reduction: 1/<b><font color='#eabe10'>2</font></b>/3",
    "modifier_vengeful_spirit_8_3": "Increases Wave of Terror Armor Reduction: 1/2/<b><font color='#eabe10'>3</font></b>",
    "modifier_vengeful_spirit_9_0": "Increase Wave of Terror Attack Damage Reduction: 5%/10%/15%",
    "modifier_vengeful_spirit_9_1": "Increase Wave of Terror Attack Damage Reduction: <b><font color='#eabe10'>5%</font></b>/10%/15%",
    "modifier_vengeful_spirit_9_2": "Increase Wave of Terror Attack Damage Reduction: 5%/<b><font color='#eabe10'>10%</font></b>/15%",
