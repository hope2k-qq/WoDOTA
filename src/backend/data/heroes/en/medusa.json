    "modifier_medusa_9_0": "Mystic Snake Damage Increase: 50% of Opponent's Strength \n\n Mystic Snake Damage Increase: 50% of Opponent's Agility \n\n Mystic Snake Damage Increase: 50% of Opponent's Intellect \n\n On creeps works based on your characteristics. \n\n Health: 100/200/300",
    "modifier_medusa_9_1": "Increase Mystic Snake Damage: <b><font color='#eabe10'>50%</font></b> of Opponent's Strength \n\n Increase Mystic Snake Damage: 50% of Opponent's Agility \n\n Increase Mystic Snake Damage: 50% of Opponent's Intellect \n\n On creeps works based on your characteristics. \n\n Health: <b><font color='#eabe10'>100</font></b>/200/300",
    "modifier_medusa_9_2": "Increase Mystic Snake Damage: <b><font color='#eabe10'>50%</font></b> of Opponent's Strength \n\n Increase Mystic Snake Damage: <b><font color='#eabe10'>50%</font></b> of Opponent's Agility \n\n Increase Mystic Snake Damage: 50% of Opponent's Intellect \n\n On creeps works based on your characteristics. \n\n Health: 100/<b><font color='#eabe10'>200</font></b>/300",
    "modifier_medusa_9_3": "Increase Mystic Snake Damage: <b><font color='#eabe10'>50%</font></b> of Opponent's Strength \n\n Increase Mystic Snake Damage: <b><font color='#eabe10'>50%</font></b> of Opponent's Agility \n\n Increase Mystic Snake Damage: <b><font color='#eabe10'>50%</font></b> of Opponent's Intellect \n\n On creeps works based on your characteristics. \n\n Health: 100/200/<b><font color='#eabe10'>300</font></b>",
