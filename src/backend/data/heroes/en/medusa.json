  "talents_description": {
    "modifier_medusa_1_0": "Increase Split Shot Damage: 5%/10%",
    "modifier_medusa_1_1": "Increase Split Shot Damage: <b><font color='#eabe10'>5%</font></b>/10%",
    "modifier_medusa_1_2": "Increase Split Shot Damage: 5%/<b><font color='#eabe10'>10%</font></b>",
    "modifier_medusa_2_0": "<b><font color='#ff0000'>Agility Gain Reduction per Level: 1/2/3 </font></b> \n\n Strength Gain per Level: 1/2/3 \n\n Attack Speed: 4%/8%/12%",
    "modifier_medusa_2_1": "<b><font color='#ff0000'>Agility Gain Reduction per Level: <b><font color='#eabe10'>1</font></b>/2/3 </font></b> \n\n Strength Gain per Level: <b><font color='#eabe10'>1</font></b>/2/3 \n\n Attack Speed: <b><font color='#eabe10'>4%</font></b>/8%/12%",
    "modifier_medusa_2_2": "<b><font color='#ff0000'>Agility Gain Reduction per Level: 1/<b><font color='#eabe10'>2</font></b>/3 </font></b> \n\n Strength Gain per Level: 1/<b><font color='#eabe10'>2</font></b>/3 \n\n Attack Speed: 4%/<b><font color='#eabe10'>8%</font></b>/12%",
    "modifier_medusa_2_3": "<b><font color='#ff0000'>Agility Gain Reduction per Level: 1/2/<b><font color='#eabe10'>3</font></b> </font></b> \n\n Strength Gain per Level: 1/2/<b><font color='#eabe10'>3</font></b> \n\n Attack Speed: 4%/8%/<b><font color='#eabe10'>12%</font></b>",
    "modifier_medusa_3_0": "<b><font color='#ff0000'>Intelligence Growth per Level Decrease: 2 </font></b> \n\n Strength Growth per Level: 2 \n\n Health: 150",
    "modifier_medusa_3_1": "<b><font color='#ff0000'>Intelligence Growth per Level Decrease: <b><font color='#eabe10'>2</font></b> </font></b> \n\n Strength Growth per Level: <b><font color='#eabe10'>2</font></b> \n\n Health: <b><font color='#eabe10'>150</font></b>",
    "modifier_medusa_4_0": "<b><font color='#ff0000'>Remove Mana Shield. </font></b> \n\n Additional Split Shots will fire on the primary target with a chance of: 10%/15%/20% \n\n Base Damage: 10/20/30",
    "modifier_medusa_4_1": "<b><font color='#ff0000'>Remove Mana Shield. </font></b> \n\n Additional Split Shots will fire on the primary target with a chance of: <b><font color='#eabe10'>10%</font></b>/15%/20% \n\n Base Damage: <b><font color='#eabe10'>10</font></b>/20/30",
    "modifier_medusa_4_2": "<b><font color='#ff0000'>Remove Mana Shield. </font></b> \n\n Additional Split Shots will fire on the primary target with a chance of: 10%/<b><font color='#eabe10'>15%</font></b>/20% \n\n Base Damage: 10/<b><font color='#eabe10'>20</font></b>/30",
    "modifier_medusa_4_3": "<b><font color='#ff0000'>Remove Mana Shield. </font></b> \n\n Additional Split Shots will fire on the primary target with a chance of: 10%/15%/<b><font color='#eabe10'>20%</font></b> \n\n Base Damage: 10/20/<b><font color='#eabe10'>30</font></b>",
