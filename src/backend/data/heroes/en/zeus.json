  "talents_description": {
    "modifier_zeus_1_0": "<b><font color='#ff0000'> Removes Lightning Bolt. </font></b> \n\n Heavenly Jump Cooldown Reduction: 2/4 sec. \n\n Can double jump with Heavenly Jump. \n\n Increases Heavenly Jump Target Capacity: 1/2",
    "modifier_zeus_1_1": "<b><font color='#ff0000'> Removes Lightning Bolt. </font></b> \n\n Heavenly Jump Cooldown Reduction: <b><font color='#eabe10'>2</font></b>/4 sec. \n\n Can double jump with Heavenly Jump. \n\n Increases Heavenly Jump Target Capacity: <b><font color='#eabe10'>1</font></b>/2",
    "modifier_zeus_1_2": "<b><font color='#ff0000'> Removes Lightning Bolt. </font></b> \n\n Heavenly Jump Cooldown Reduction: 2/<b><font color='#eabe10'>4</font></b> sec. \n\n Can double jump with Heavenly Jump. \n\n Increases Heavenly Jump Target Capacity: 1/<b><font color='#eabe10'>2</font></b>",
    "modifier_zeus_2_0": "<b><font color='#ff0000'> Removes Arc Lightning. </font></b> \n\n Landing Heavenly Jump deals 1/2 attacks to all targets hit. \n\n Radius: 350 \n\n Attack Speed: 20/40",
    "modifier_zeus_2_1": "<b><font color='#ff0000'> Removes Arc Lightning. </font></b> \n\n Landing Heavenly Jump deals <b><font color='#eabe10'>1</font></b>/2 attacks to all targets hit. \n\n Radius: 350 \n\n Attack Speed: <b><font color='#eabe10'>20</font></b>/40",
    "modifier_zeus_2_2": "<b><font color='#ff0000'> Removes Arc Lightning. </font></b> \n\n Landing Heavenly Jump deals 1/<b><font color='#eabe10'>2</font></b> attacks to all targets hit. \n\n Radius: 350 \n\n Attack Speed: 20/<b><font color='#eabe10'>40</font></b>",
    "modifier_zeus_3_0": "Landing Heavenly Jump stuns enemies. Pierces Magic Immunity. \n\n Stun Duration: 0.8/1.6 sec. \n\n Base Damage: 20/40",
    "modifier_zeus_3_1": "Landing Heavenly Jump stuns enemies. Pierces Magic Immunity. \n\n Stun Duration: <b><font color='#eabe10'>0.8</font></b>/1.6 sec. \n\n Base Damage: <b><font color='#eabe10'>20</font></b>/40",
    "modifier_zeus_3_2": "Landing Heavenly Jump stuns enemies. Pierces Magic Immunity. \n\n Stun Duration: 0.8/<b><font color='#eabe10'>1.6</font></b> sec. \n\n Base Damage: 20/<b><font color='#eabe10'>40</font></b>",
    "modifier_zeus_4_0": "Heavenly Jump does not cost Mana. \n\n Heavenly Jump becomes a point-based ability. \n\n Killing a Creep or Illusion reduces the cooldown of Heavenly Jump by 1 sec. \n\n Killing a Champion Creep reduces the cooldown of Heavenly Jump: 5 sec. \n\n Killing a Hero reduces the cooldown of Heavenly Jump: 10 sec.",
    "modifier_zeus_4_1": "Heavenly Jump does not cost Mana. \n\n Heavenly Jump becomes a point-based ability. \n\n Killing a Creep or Illusion reduces the cooldown of Heavenly Jump by <b><font color='#eabe10'>1</font></b> sec. \n\n Killing a Champion Creep reduces the cooldown of Heavenly Jump: <b><font color='#eabe10'>5</font></b> sec. \n\n Killing a Hero reduces the cooldown of Heavenly Jump: <b><font color='#eabe10'>10</font></b> sec.",
    "modifier_zeus_5_0": "Reduces the Cooldown of Thundergod's Wrath: 20/40/60 sec. \n\n Thundergod's Wrath deals 1 attack to all targets hit.",
    "modifier_zeus_5_1": "Reduces the Cooldown of Thundergod's Wrath: <b><font color='#eabe10'>20</font></b>/40/60 sec. \n\n Thundergod's Wrath deals <b><font color='#eabe10'>1</font></b> attack to all targets hit.",
    "modifier_zeus_5_2": "Reduces the Cooldown of Thundergod's Wrath: 20/<b><font color='#eabe10'>40</font></b>/60 sec. \n\n Thundergod's Wrath deals <b><font color='#eabe10'>1</font></b> attack to all targets hit.",
    "modifier_zeus_5_3": "Reduces the Cooldown of Thundergod's Wrath: 20/40/<b><font color='#eabe10'>60</font></b> sec. \n\n Thundergod's Wrath deals <b><font color='#eabe10'>1</font></b> attack to all targets hit.",
    "modifier_zeus_6_0": "Heavenly Jump can be used while Rooted. \n\n Immune to Magic during Heavenly Jump. \n\n Strength: 0/10/20",
    "modifier_zeus_6_1": "Heavenly Jump can be used while Rooted. \n\n Immune to Magic during Heavenly Jump. \n\n Strength: <b><font color='#eabe10'>0</font></b>/10/20",
