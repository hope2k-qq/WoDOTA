    "modifier_marci_1_2": "Dispose Damage Increase: 70/<b><font color='#eabe10'>140</font></b>",
    "modifier_marci_2_0": "Movement Speed: 15/30 \n\n Status Resistance: 5%/10%",
    "modifier_marci_2_1": "Movement Speed: <b><font color='#eabe10'>15</font></b>/30 \n\n Status Resistance: <b><font color='#eabe10'>5%</font></b>/10%",
    "modifier_marci_2_2": "Movement Speed: 15/<b><font color='#eabe10'>30</font></b> \n\n Status Resistance: 5%/<b><font color='#eabe10'>10%</font></b>",
    "modifier_marci_3_0": "Unleash Duration Increase: 4/8 sec. \n\n Mana Regeneration: 3/6",
    "modifier_marci_3_1": "Unleash Duration Increase: <b><font color='#eabe10'>4</font></b>/8 sec. \n\n Mana Regeneration: <b><font color='#eabe10'>3</font></b>/6",
    "modifier_marci_3_2": "Unleash Duration Increase: 4/<b><font color='#eabe10'>8</font></b> sec. \n\n Mana Regeneration: 3/<b><font color='#eabe10'>6</font></b>",
    "modifier_marci_4_0": "Bodyguard works only on heroes. \n\n Barrier Health Regeneration Increase: 10%/20% \n\n Total Barrier Health Increase: 100/200",
    "modifier_marci_4_1": "Bodyguard works only on <b><font color='#eabe10'>heroes</font></b>. \n\n Barrier Health Regeneration Increase: <b><font color='#eabe10'>10%</font></b>/20% \n\n Total Barrier Health Increase: <b><font color='#eabe10'>100</font></b>/200",
    "modifier_marci_4_2": "Bodyguard works only on <b><font color='#eabe10'>heroes</font></b>. \n\n Barrier Health Regeneration Increase: 10%/<b><font color='#eabe10'>20%</font></b> \n\n Total Barrier Health Increase: 100/<b><font color='#eabe10'>200</font></b>",
    "modifier_marci_5_0": "Unleash Pulses steal Strength from Heroes: 5 \n\n Duration: 5/10/15 sec. \n\n Unleash Pulse Damage Increase to Creeps: 50/100/150",
    "modifier_marci_5_1": "Unleash Pulses steal Strength from Heroes: <b><font color='#eabe10'>5</font></b> \n\n Duration: <b><font color='#eabe10'>5</font></b>/10/15 sec. \n\n Unleash Pulse Damage Increase to Creeps: <b><font color='#eabe10'>50</font></b>/100/150",
    "modifier_marci_5_2": "Unleash Pulses steal Strength from Heroes: <b><font color='#eabe10'>5</font></b> \n\n Duration: 5/<b><font color='#eabe10'>10</font></b>/15 sec. \n\n Unleash Pulse Damage Increase to Creeps: 50/<b><font color='#eabe10'>100</font></b>/150",
    "modifier_marci_5_3": "Unleash Pulses steal Strength from Heroes: <b><font color='#eabe10'>5</font></b> \n\n Duration: 5/10/<b><font color='#eabe10'>15</font></b> sec. \n\n Unleash Pulse Damage Increase to Creeps: 50/100/<b><font color='#eabe10'>150</font></b>",
    "modifier_marci_6_0": "Each Unleash Pulse reduces Unleash Cooldown: 1/2 sec.",
    "modifier_marci_6_1": "Each Unleash Pulse reduces Unleash Cooldown: <b><font color='#eabe10'>1</font></b>/2 sec.",
