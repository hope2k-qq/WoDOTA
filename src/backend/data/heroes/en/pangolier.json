    "modifier_pangolier_18_1": "Rolling Thunder always starts with <b><font color='#eabe10'>Shield Crash</font></b>. \n\n Rolling Thunder Cooldown Reduction: <b><font color='#eabe10'>15</font></b>/25/35 sec.",
    "modifier_pangolier_18_2": "Rolling Thunder always starts with <b><font color='#eabe10'>Shield Crash</font></b>. \n\n Rolling Thunder Cooldown Reduction: 15/<b><font color='#eabe10'>25</font></b>/35 sec.",
    "modifier_pangolier_18_3": "Rolling Thunder always starts with <b><font color='#eabe10'>Shield Crash</font></b>. \n\n Rolling Thunder Cooldown Reduction: 15/25/<b><font color='#eabe10'>35</font></b> sec.",
