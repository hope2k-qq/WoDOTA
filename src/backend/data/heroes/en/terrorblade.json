  "talents_description": {
    "modifier_terrorblade_1_0": "Health: 150/300",
    "modifier_terrorblade_1_1": "Health: <b><font color='#eabe10'>150</font></b>/300",
    "modifier_terrorblade_1_2": "Health: 150/<b><font color='#eabe10'>300</font></b>",
    "modifier_terrorblade_2_0": "New Active Ability: Demon Zeal \n\n The hero sacrifices a portion of their current health to gain bonus attack speed and health regeneration. \n\n Health Cost: 20% \n Attack Speed: 50 \n Health Regeneration: 10 \n Cooldown: 16 sec. \n Duration: 11 sec.",
    "modifier_terrorblade_2_1": "New Active Ability: <b><font color='#eabe10'>Demon Zeal</font></b> \n\n The hero sacrifices a portion of their current health to gain bonus attack speed and health regeneration. \n\n Health Cost: 20% \n Attack Speed: <b><font color='#eabe10'>50</font></b> \n Health Regeneration: <b><font color='#eabe10'>10</font></b> \n Cooldown: 16 sec. \n Duration: 11 sec.",
    "modifier_terrorblade_3_0": "<b><font color='#ff0000'>Removes Conjure Image.</font></b> \n\n Metamorphosis Cooldown Reduction: 30/60/90 seconds",
    "modifier_terrorblade_3_1": "<b><font color='#ff0000'>Removes Conjure Image.</font></b> \n\n Metamorphosis Cooldown Reduction: <b><font color='#eabe10'>30</font></b>/60/90 seconds",
    "modifier_terrorblade_3_2": "<b><font color='#ff0000'>Removes Conjure Image.</font></b> \n\n Metamorphosis Cooldown Reduction: 30/<b><font color='#eabe10'>60</font></b>/90 seconds",
    "modifier_terrorblade_3_3": "<b><font color='#ff0000'>Removes Conjure Image.</font></b> \n\n Metamorphosis Cooldown Reduction: 30/60/<b><font color='#eabe10'>90</font></b> seconds",
    "modifier_terrorblade_4_0": "Increases Demon Zeal Attack Speed: 25/50 \n\n Increases Demon Zeal Health Regeneration: 5/10",
    "modifier_terrorblade_4_1": "Increases Demon Zeal Attack Speed: <b><font color='#eabe10'>25</font></b>/50 \n\n Increases Demon Zeal Health Regeneration: <b><font color='#eabe10'>5</font></b>/10",
    "modifier_terrorblade_4_2": "Increases Demon Zeal Attack Speed: 25/<b><font color='#eabe10'>50</font></b> \n\n Increases Demon Zeal Health Regeneration: 5/<b><font color='#eabe10'>10</font></b>",
    "modifier_terrorblade_5_0": "Health Regeneration During Metamorphosis: 0.4%/0.8%",
    "modifier_terrorblade_5_1": "Health Regeneration During Metamorphosis: <b><font color='#eabe10'>0.4%</font></b>/0.8%",
    "modifier_terrorblade_5_2": "Health Regeneration During Metamorphosis: 0.4%/<b><font color='#eabe10'>0.8%</font></b>",
    "modifier_terrorblade_6_0": "Demon Zeal applies a Basic Dispel. \n\n Status Resistance during Demon Zeal: 0%/10%/20%",
    "modifier_terrorblade_6_1": "Demon Zeal applies a <b><font color='#eabe10'>Basic Dispel</font></b>. \n\n Status Resistance during Demon Zeal: <b><font color='#eabe10'>0%</font></b>/10%/20%",
    "modifier_terrorblade_6_2": "Demon Zeal applies a <b><font color='#eabe10'>Basic Dispel</font></b>. \n\n Status Resistance during Demon Zeal: 0%/<b><font color='#eabe10'>10%</font></b>/20%",
    "modifier_terrorblade_6_3": "Demon Zeal applies a <b><font color='#eabe10'>Basic Dispel</font></b>. \n\n Status Resistance during Demon Zeal: 0%/10%/<b><font color='#eabe10'>20%</font></b>",
    "modifier_terrorblade_7_0": "When Damage Received reaches a limit of 10% of your Max Health, the Hero gains Inrage. \n\n Inrage increases all Damage Dealt by 7%. \n\n Effect Duration: 7 seconds",
    "modifier_terrorblade_7_1": "When Damage Received reaches a limit of 10% of your Max Health, the Hero gains <b><font color='#eabe10'>Inrage</font></b>. \n\n Inrage increases all Damage Dealt by <b><font color='#eabe10'>7%</font></b>. \n\n Effect Duration: 7 seconds",
    "modifier_terrorblade_8_0": "Conjure Image Illusion Damage Reduction: 50%/100%",
