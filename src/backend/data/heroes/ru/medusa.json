    "modifier_medusa_15_1": "Каждая Атака восстанавливает Ману: <b><font color='#eabe10'>8</font></b>/16",
    "modifier_medusa_15_2": "Каждая Атака восстанавливает Ману: 8/<b><font color='#eabe10'>16</font></b>",
