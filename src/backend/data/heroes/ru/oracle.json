  "talents_description": {
    "modifier_oracle_1_0": "Сила: 5/10/15 \n\n Базовый Урон: 5/10/15",
    "modifier_oracle_1_1": "Сила: <b><font color='#eabe10'>5</font></b>/10/15 \n\n Базовый Урон: <b><font color='#eabe10'>5</font></b>/10/15",
    "modifier_oracle_1_2": "Сила: 5/<b><font color='#eabe10'>10</font></b>/15 \n\n Базовый Урон: 5/<b><font color='#eabe10'>10</font></b>/15",
    "modifier_oracle_1_3": "Сила: 5/10/<b><font color='#eabe10'>15</font></b> \n\n Базовый Урон: 5/10/<b><font color='#eabe10'>15</font></b>",
    "modifier_oracle_2_0": "0.2 Восстановления Здоровья за каждые 1 Силы",
    "modifier_oracle_2_1": "<b><font color='#eabe10'>0.2</font></b> Восстановления Здоровья за каждые <b><font color='#eabe10'>1 Силы</font></b>",
    "modifier_oracle_3_0": "<b><font color='#ff0000'>Уменьшение Здоровья: 3%/6%/9%</font></b> \n\n Сила: 4%/8%/12%",
    "modifier_oracle_3_1": "<b><font color='#ff0000'>Уменьшение Здоровья: <b><font color='#eabe10'>3%</font></b>/6%/9%</font></b> \n\n Сила: <b><font color='#eabe10'>4%</font></b>/8%/12%",
    "modifier_oracle_3_2": "<b><font color='#ff0000'>Уменьшение Здоровья: 3%/<b><font color='#eabe10'>6%</font></b>/9%</font></b> \n\n Сила: 4%/<b><font color='#eabe10'>8%</font></b>/12%",
    "modifier_oracle_3_3": "<b><font color='#ff0000'>Уменьшение Здоровья: 3%/6%/<b><font color='#eabe10'>9%</font></b></font></b> \n\n Сила: 4%/8%/<b><font color='#eabe10'>12%</font></b>",
    "modifier_oracle_4_0": "<b><font color='#ff0000'>Уменьшение Здоровья: 3%/6%/9%</font></b> \n\n 1% Урона от Заклинаний за каждые 12/8/4 Силы",
    "modifier_oracle_4_1": "<b><font color='#ff0000'>Уменьшение Здоровья: <b><font color='#eabe10'>3%</font></b>/6%/9%</font></b> \n\n <b><font color='#eabe10'>1%</font></b> Урона от Заклинаний за каждые <b><font color='#eabe10'>12</font></b>/8/4 <b><font color='#eabe10'>Силы</font></b>",
    "modifier_oracle_4_2": "<b><font color='#ff0000'>Уменьшение Здоровья: 3%/<b><font color='#eabe10'>6%</font></b>/9%</font></b> \n\n <b><font color='#eabe10'>1%</font></b> Урона от Заклинаний за каждые 12/<b><font color='#eabe10'>8</font></b>/4 <b><font color='#eabe10'>Силы</font></b>",
    "modifier_oracle_4_3": "<b><font color='#ff0000'>Уменьшение Здоровья: 3%/6%/<b><font color='#eabe10'>9%</font></b></font></b> \n\n <b><font color='#eabe10'>1%</font></b> Урона от Заклинаний за каждые 12/8/<b><font color='#eabe10'>4</font></b> <b><font color='#eabe10'>Силы</font></b>",
    "modifier_oracle_5_0": "False Promise Уменьшает Весь Получаемый Урон: 15%/30%",
    "modifier_oracle_5_1": "False Promise Уменьшает Весь Получаемый Урон: <b><font color='#eabe10'>15%</font></b>/30%",
    "modifier_oracle_5_2": "False Promise Уменьшает Весь Получаемый Урон: 15%/<b><font color='#eabe10'>30%</font></b>",
    "modifier_oracle_6_0": "Увеличение Лечения Purifying Flames в Секунду: 10% от Силы",
    "modifier_oracle_6_1": "Увеличение Лечения Purifying Flames в Секунду: <b><font color='#eabe10'>10%</font></b> от Силы",
    "modifier_oracle_7_0": "<b><font color='#ff0000'>Убирает Fate's Edict.</font></b> \n\n Новая Активная Способность: Change of Fate's \n\n Искажает судьбу выбранной цели, во время действия эффекта всё Получаемое Лечение - наносит Чистый Урон, а весь Получаемый Урон - Исцеляет. Нельзя развеять.\n\n Длительность: 5 сек. \n Время Перезарядки: 18 сек.",
    "modifier_oracle_7_1": "<b><font color='#ff0000'>Убирает Fate's Edict.</font></b> \n\n Новая Активная Способность: <b><font color='#eabe10'>Change of Fate's</font></b> \n\n Искажает судьбу выбранной цели, во время действия эффекта всё Получаемое Лечение - наносит Чистый Урон, а весь Получаемый Урон - Исцеляет. Нельзя развеять.\n\n Длительность: 5 сек. \n Время Перезарядки: 18 сек.",
    "modifier_oracle_8_0": "Увеличение Скорости Атаки по жертвам Fortune's End: 35/70/105 \n\n Длительность: 8 сек.",
    "modifier_oracle_8_1": "Увеличение Скорости Атаки по жертвам Fortune's End: <b><font color='#eabe10'>35</font></b>/70/105 \n\n Длительность: 8 сек.",
    "modifier_oracle_8_2": "Увеличение Скорости Атаки по жертвам Fortune's End: 35/<b><font color='#eabe10'>70</font></b>/105 \n\n Длительность: 8 сек.",
    "modifier_oracle_8_3": "Увеличение Скорости Атаки по жертвам Fortune's End: 35/70/<b><font color='#eabe10'>105</font></b> \n\n Длительность: 8 сек.",
    "modifier_oracle_9_0": "Fortune's End можно применить на область. \n\n Увеличение Радиуса Fortune's End: 100/200",
    "modifier_oracle_9_1": "Fortune's End можно применить <b><font color='#eabe10'>на область</font></b>. \n\n Увеличение Радиуса Fortune's End: <b><font color='#eabe10'>100</font></b>/200",
    "modifier_oracle_9_2": "Fortune's End можно применить <b><font color='#eabe10'>на область</font></b>. \n\n Увеличение Радиуса Fortune's End: 100/<b><font color='#eabe10'>200</font></b>",
    "modifier_oracle_10_0": "Fortune's End не нужно поддерживать, он срабатывает моментально и с максимальной силой. \n\n Базовый Урон: 11",
    "modifier_oracle_10_1": "Fortune's End не нужно поддерживать, он срабатывает моментально и с <b><font color='#eabe10'>максимальной</font></b> силой. \n\n Базовый Урон: <b><font color='#eabe10'>11</font></b>",
    "modifier_oracle_11_0": "Fortune's End не требует маны. \n\n Fortune's End наносит Физический Урон, а не Магический. \n\n Увеличение Урона Fortune's End: 150%/200%/250% от Ловкости",
    "modifier_oracle_11_1": "Fortune's End <b><font color='#eabe10'>не требует</font></b> маны. \n\n Fortune's End наносит <b><font color='#eabe10'>Физический</font></b> Урон, а не Магический. \n\n Увеличение Урона Fortune's End: <b><font color='#eabe10'>150%</font></b>/200%/250% от Ловкости",
    "modifier_oracle_11_2": "Fortune's End <b><font color='#eabe10'>не требует</font></b> маны. \n\n Fortune's End наносит <b><font color='#eabe10'>Физический</font></b> Урон, а не Магический. \n\n Увеличение Урона Fortune's End: 150%/<b><font color='#eabe10'>200%</font></b>/250% от Ловкости",
    "modifier_oracle_11_3": "Fortune's End <b><font color='#eabe10'>не требует</font></b> маны. \n\n Fortune's End наносит <b><font color='#eabe10'>Физический</font></b> Урон, а не Магический. \n\n Увеличение Урона Fortune's End: 150%/200%/<b><font color='#eabe10'>250%</font></b> от Ловкости",
    "modifier_oracle_12_0": "Увеличение Длительности Fate's Edict: 1 сек.",
    "modifier_oracle_12_1": "Увеличение Длительности Fate's Edict: <b><font color='#eabe10'>1</font></b> сек.",
    "modifier_oracle_13_0": "<b><font color='#ff0000'>Убирает Purifying Flames.</font></b> \n\n Вампиризм: 6%/12%/18% \n\n Вампиризм Заклинаниями: 6%/12%/18%",
    "modifier_oracle_13_1": "<b><font color='#ff0000'>Убирает Purifying Flames.</font></b> \n\n Вампиризм: <b><font color='#eabe10'>6%</font></b>/12%/18% \n\n Вампиризм Заклинаниями: <b><font color='#eabe10'>6%</font></b>/12%/18%",
    "modifier_oracle_13_2": "<b><font color='#ff0000'>Убирает Purifying Flames.</font></b> \n\n Вампиризм: 6%/<b><font color='#eabe10'>12%</font></b>/18% \n\n Вампиризм Заклинаниями: 6%/<b><font color='#eabe10'>12%</font></b>/18%",
    "modifier_oracle_13_3": "<b><font color='#ff0000'>Убирает Purifying Flames.</font></b> \n\n Вампиризм: 6%/12%/<b><font color='#eabe10'>18%</font></b> \n\n Вампиризм Заклинаниями: 6%/12%/<b><font color='#eabe10'>18%</font></b>",
    "modifier_oracle_14_0": "Новая Пассивная Способность: Diviner's Deck \n\n При получении этой способности и каждые 90 сек. после этого герой вытягивает случайную карту таро. Он всегда знает, какая карта будет следующей. Одновременно может действовать только одна карта. \n\n <b>«Смерть»</b>: +40% к Урону от Заклинаний \n<b>«Шут»</b>: +20% к Получаемому Золоту \n<b>«Мир»</b>: +40% к Интеллекту \n<b>«Влюблённые»</b>: +40% к Усилению Лечения \n<b>«Башня»</b>: Барьер от всех типов урона с 400 здоровья (восстанавливается, если не получать урон 7 сек.)",
    "modifier_oracle_14_1": "Новая Пассивная Способность: <b><font color='#eabe10'>Diviner's Deck</font></b> \n\n При получении этой способности и каждые 90 сек. после этого герой вытягивает случайную карту таро. Он всегда знает, какая карта будет следующей. Одновременно может действовать только одна карта. \n\n <b>«Смерть»</b>: <b><font color='#eabe10'>+40%</font></b> к Урону от Заклинаний \n<b>«Шут»</b>: <b><font color='#eabe10'>+20%</font></b> к Получаемому Золоту \n<b>«Мир»</b>: <b><font color='#eabe10'>+40%</font></b> к Интеллекту \n<b>«Влюблённые»</b>: <b><font color='#eabe10'>+40%</font></b> к Усилению Лечения \n<b>«Башня»</b>: Барьер от всех типов урона с <b><font color='#eabe10'>400</font></b> здоровья (восстанавливается, если не получать урон 7 сек.)",
    "modifier_oracle_15_0": "Если в радиусе 300 от цели Purifying Flames будут крипы, то способность сработает на них ещё 1/2 раза. \n\n Каждый уровень героя увеличивает Урон от Заклинаний: 0.5%",
    "modifier_oracle_15_1": "Если в радиусе 300 от цели Purifying Flames будут крипы, то способность сработает на них ещё <b><font color='#eabe10'>1</font></b>/2 раза. \n\n Каждый уровень героя увеличивает Урон от Заклинаний: <b><font color='#eabe10'>0.5%</font></b>",
    "modifier_oracle_15_2": "Если в радиусе 300 от цели Purifying Flames будут крипы, то способность сработает на них ещё 1/<b><font color='#eabe10'>2</font></b> раза. \n\n Каждый уровень героя увеличивает Урон от Заклинаний: <b><font color='#eabe10'>0.5%</font></b>",
    "modifier_oracle_16_0": "Сопротивление Магии: 3%/6%/9% \n\n Броня: 2/4/6",
    "modifier_oracle_16_1": "Сопротивление Магии: <b><font color='#eabe10'>3%</font></b>/6%/9% \n\n Броня: <b><font color='#eabe10'>2</font></b>/4/6",
    "modifier_oracle_16_2": "Сопротивление Магии: 3%/<b><font color='#eabe10'>6%</font></b>/9% \n\n Броня: 2/<b><font color='#eabe10'>4</font></b>/6",
    "modifier_oracle_16_3": "Сопротивление Магии: 3%/6%/<b><font color='#eabe10'>9%</font></b> \n\n Броня: 2/4/<b><font color='#eabe10'>6</font></b>",
    "modifier_oracle_17_0": "Новая Активная Способность: Rain of Destiny \n\n Герой вызывает вокруг себя дождь, который наносит врагам урон и излечивает союзников. Всё лечение, получаемое под дождём, уменьшается для врагов и увеличивается для союзников. \n\n Урон/Лечение в Секунду: 30 + 80% от Восстановления Маны \n Изменение Лечения: 15% \n Длительность: 10 сек. \n Радиус: 650 \n Время Перезарядки: 40 сек. \n Затраты Маны: 150",
    "modifier_oracle_17_1": "Новая Активная Способность: <b><font color='#eabe10'>Rain of Destiny</font></b> \n\n Герой вызывает вокруг себя дождь, который наносит врагам урон и излечивает союзников. Всё лечение, получаемое под дождём, уменьшается для врагов и увеличивается для союзников. \n\n Урон/Лечение в Секунду: <b><font color='#eabe10'>30</font></b> + <b><font color='#eabe10'>80%</font></b> от Восстановления Маны \n Изменение Лечения: <b><font color='#eabe10'>15%</font></b> \n Длительность: 10 сек. \n Радиус: 650 \n Время Перезарядки: 40 сек. \n Затраты Маны: 150",
    "modifier_oracle_18_0": "По окончании False Promise враги в радиусе 500 получают Чистый Урон, равный 20%/30%/40% от Полученного Героем Урона за время действия способности.\n\n <b><font color='#ff0000'>Максимальный урон способности 2000.</font></b>",
    "modifier_oracle_18_1": "По окончании False Promise враги в радиусе 500 получают Чистый Урон, равный <b><font color='#eabe10'>20%</font></b>/30%/40% от Полученного Героем Урона за время действия способности.\n\n <b><font color='#ff0000'>Максимальный урон способности 2000.</font></b>",
    "modifier_oracle_18_2": "По окончании False Promise враги в радиусе 500 получают Чистый Урон, равный 20%/<b><font color='#eabe10'>30%</font></b>/40% от Полученного Героем Урона за время действия способности.\n\n <b><font color='#ff0000'>Максимальный урон способности 2000.</font></b>",
    "modifier_oracle_18_3": "По окончании False Promise враги в радиусе 500 получают Чистый Урон, равный 20%/30%/<b><font color='#eabe10'>40%</font></b> от Полученного Героем Урона за время действия способности.\n\n <b><font color='#ff0000'>Максимальный урон способности 2000.</font></b>",
    "modifier_oracle_19_0": "Уменьшение Времени Перезарядки False Promise: 6/12 сек.",
    "modifier_oracle_19_1": "Уменьшение Времени Перезарядки False Promise: <b><font color='#eabe10'>6</font></b>/12 сек.",
    "modifier_oracle_19_2": "Уменьшение Времени Перезарядки False Promise: 6/<b><font color='#eabe10'>12</font></b> сек.",
    "modifier_oracle_20_0": "Purifying Flames не Исцеляет Противников. \n\n Увеличение Урона Purifying Flames: 40%/80% от Восстановления Маны",
    "modifier_oracle_20_1": "Purifying Flames не Исцеляет Противников. \n\n Увеличение Урона Purifying Flames: <b><font color='#eabe10'>40%</font></b>/80% от Восстановления Маны",
    "modifier_oracle_20_2": "Purifying Flames не Исцеляет Противников. \n\n Увеличение Урона Purifying Flames: 40%/<b><font color='#eabe10'>80%</font></b> от Восстановления Маны",
    "modifier_oracle_21_0": "Если False Promise не находится на перезарядке, то способность сработает автоматически на 1 Здоровье. \n\n По окончании эффекта False Promise герой не может умереть. Вместо этого у него остаётся 10% от Максимального Здоровья.",
    "modifier_oracle_21_1": "Если False Promise не находится на перезарядке, то способность сработает <b><font color='#eabe10'>автоматически</font></b> на 1 Здоровье. \n\n По окончании эффекта False Promise герой не может умереть. Вместо этого у него остаётся <b><font color='#eabe10'>10%</font></b> от Максимального Здоровья."
