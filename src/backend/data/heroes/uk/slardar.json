  "talents_description": {
    "modifier_slardar_1_0": "Збільшення Радіуса Ставки Slithereen Crush: 125/250 \n\n Збільшення Тривалості Ставки Slithereen Crush: 2/4 сек.",
    "modifier_slardar_1_1": "Збільшення Радіуса Ставки Slithereen Crush: <b><font color='#eabe10'>125</font></b>/250 \n\n Збільшення Тривалості Ставки Slithereen Crush: <b><font color='#eabe10'>2</font></b>/4 сек.",
    "modifier_slardar_1_2": "Збільшення Радіуса Ставки Slithereen Crush: 125/<b><font color='#eabe10'>250</font></b> \n\n Збільшення Тривалості Ставки Slithereen Crush: 2/<b><font color='#eabe10'>4</font></b> сек.",
    "modifier_slardar_2_0": "Ставок Slithereen Crush завдає Фізичної Шкоди за Секунду: 25 + 150%/200%/250% від Броні",
    "modifier_slardar_2_1": "Ставок Slithereen Crush завдає Фізичної Шкоди за Секунду: <b><font color='#eabe10'>25</font></b> + <b><font color='#eabe10'>150%</font></b>/200%/250% від Броні",
    "modifier_slardar_2_2": "Ставок Slithereen Crush завдає Фізичної Шкоди за Секунду: <b><font color='#eabe10'>25</font></b> + 150%/<b><font color='#eabe10'>200%</font></b>/250% від Броні",
    "modifier_slardar_2_3": "Ставок Slithereen Crush завдає Фізичної Шкоди за Секунду: <b><font color='#eabe10'>25</font></b> + 150%/200%/<b><font color='#eabe10'>250%</font></b> від Броні",
    "modifier_slardar_3_0": "Збільшення Тривалості Оглушення Slithereen Crush: 0.4/0.8 сек.",
    "modifier_slardar_3_1": "Збільшення Тривалості Оглушення Slithereen Crush: <b><font color='#eabe10'>0.4</font></b>/0.8 сек.",
    "modifier_slardar_3_2": "Збільшення Тривалості Оглушення Slithereen Crush: 0.4/<b><font color='#eabe10'>0.8</font></b> сек.",
    "modifier_slardar_4_0": "Збільшує Броню на 1 за кожні 24/18/12 Сили",
    "modifier_slardar_4_1": "Збільшує Броню на <b><font color='#eabe10'>1</font></b> за кожні <b><font color='#eabe10'>24</font></b>/18/12 Сили",
    "modifier_slardar_4_2": "Збільшує Броню на <b><font color='#eabe10'>1</font></b> за кожні 24/<b><font color='#eabe10'>18</font></b>/12 Сили",
    "modifier_slardar_4_3": "Збільшує Броню на <b><font color='#eabe10'>1</font></b> за кожні 24/18/<b><font color='#eabe10'>12</font></b> Сили",
    "modifier_slardar_5_0": "Збільшує Зниження Броні від Corrosive Haze: 8",
