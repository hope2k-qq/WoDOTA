    "modifier_dazzle_4_0": "Increase Good Juju Radius: 75/150",
    "modifier_dazzle_4_1": "Increase Good Juju Radius: <b><font color='#eabe10'>75</font></b>/150",
    "modifier_dazzle_4_2": "Increase Good Juju Radius: 75/<b><font color='#eabe10'>150</font></b>",
    "modifier_dazzle_5_0": "Health Regeneration increases Mana Regeneration: 20%/40%",
