  "talents_description": {
    "modifier_tiny_1_0": "Damage: 1% of Max Health",
    "modifier_tiny_1_1": "Damage: <b><font color='#eabe10'>1%</font></b> of Max Health",
    "modifier_tiny_2_0": "<b><font color='#ff0000'>Remove Toss.</font></b> \n\n Removes the limit on the number of attacks with Tree Grab.",
    "modifier_tiny_2_1": "<b><font color='#ff0000'>Remove Toss.</font></b> \n\n Removes the limit on the number of attacks with <b><font color='#eabe10'>Tree Grab</font></b>.",
    "modifier_tiny_3_0": "<b><font color='#ff0000'>Total Damage Taken Increase: 2%/4%/6% </font></b> \n\n Total Damage Dealt Increase: 4%/8%/12%",
    "modifier_tiny_3_1": "<b><font color='#ff0000'>Total Damage Taken Increase: <b><font color='#eabe10'>2%</font></b>/4%/6% </font></b> \n\n Total Damage Dealt Increase: <b><font color='#eabe10'>4%</font></b>/8%/12%",
    "modifier_tiny_3_2": "<b><font color='#ff0000'>Total Damage Taken Increase: 2%/<b><font color='#eabe10'>4%</font></b>/6% </font></b> \n\n Total Damage Dealt Increase: 4%/<b><font color='#eabe10'>8%</font></b>/12%",
    "modifier_tiny_3_3": "<b><font color='#ff0000'>Total Damage Taken Increase: 2%/4%/<b><font color='#eabe10'>6%</font></b> </font></b> \n\n Total Damage Dealt Increase: 4%/8%/<b><font color='#eabe10'>12%</font></b>",
    "modifier_tiny_4_0": "Increase Avalanche Total Damage: 3%/6% of Max Health",
    "modifier_tiny_4_1": "Increase Avalanche Total Damage: <b><font color='#eabe10'>3%</font></b>/6% of Max Health",
    "modifier_tiny_4_2": "Increase Avalanche Total Damage: 3%/<b><font color='#eabe10'>6%</font></b> of Max Health",
    "modifier_tiny_5_0": "Each attack has a 20% chance of dealing Critical Damage: 120%/140%/160%",
    "modifier_tiny_5_1": "Each attack has a <b><font color='#eabe10'>20%</font></b> chance of dealing Critical Damage: <b><font color='#eabe10'>120%</font></b>/140%/160%",
    "modifier_tiny_5_2": "Each attack has a <b><font color='#eabe10'>20%</font></b> chance of dealing Critical Damage: 120%/<b><font color='#eabe10'>140%</font></b>/160%",
    "modifier_tiny_5_3": "Each attack has a <b><font color='#eabe10'>20%</font></b> chance of dealing Critical Damage: 120%/140%/<b><font color='#eabe10'>160%</font></b>",
    "modifier_tiny_6_0": "Increase Avalanche Total Duration: 0.3/0.6/0.9 sec.",
    "modifier_tiny_6_1": "Increase Avalanche Total Duration: <b><font color='#eabe10'>0.3</font></b>/0.6/0.9 sec.",
    "modifier_tiny_6_2": "Increase Avalanche Total Duration: 0.3/<b><font color='#eabe10'>0.6</font></b>/0.9 sec.",
    "modifier_tiny_6_3": "Increase Avalanche Total Duration: 0.3/0.6/<b><font color='#eabe10'>0.9</font></b> sec.",
    "modifier_tiny_7_0": "Strength: 15 \n\n New Active Ability: Tree Volley \n\n The hero uproots random nearby trees and hurls them at the target area. Each thrown tree deals the hero's attack damage to enemies. This ability works even if there are no nearby trees. \n\n Area Radius: 400 \n Throw Interval: 0.5 sec. \n Maximum Duration: 2.5 sec. \n Cooldown: 12 sec.",
    "modifier_tiny_7_1": "Strength: <b><font color='#eabe10'>15</font></b> \n\n New Active Ability: <b><font color='#eabe10'>Tree Volley</font></b> \n\n The hero uproots random nearby trees and hurls them at the target area. Each thrown tree deals the hero's attack damage to enemies. This ability works even if there are no nearby trees. \n\n Area Radius: 400 \n Throw Interval: 0.5 sec. \n Maximum Duration: <b><font color='#eabe10'>2.5</font></b> sec. \n Cooldown: 12 sec.",
    "modifier_tiny_8_0": "<b><font color='#ff0000'>Strength Gain Reduction per Level: 1.5/3 </font></b> \n\n Agility Gain per Level: 1.5/3",
    "modifier_tiny_8_1": "<b><font color='#ff0000'>Strength Gain Reduction per Level: <b><font color='#eabe10'>1.5</font></b>/3 </font></b> \n\n Agility Gain per Level: <b><font color='#eabe10'>1.5</font></b>/3",
    "modifier_tiny_8_2": "<b><font color='#ff0000'>Strength Gain Reduction per Level: 1.5/<b><font color='#eabe10'>3</font></b> </font></b> \n\n Agility Gain per Level: 1.5/<b><font color='#eabe10'>3</font></b>",
    "modifier_tiny_9_0": "<b><font color='#ff0000'>Removes Grow.</font></b> \n\n New Passive Ability: Tiny's Ring \n\n Allows the hero to walk through units and trees. Enemies beneath the hero take damage every second based on his Agility. \n\n Model Size Reduction: 10% \n Radius: 100 \n Damage per Second: 110% of Agility",
    "modifier_tiny_9_1": "<b><font color='#ff0000'>Removes Grow.</font></b> \n\n New Passive Ability: <b><font color='#eabe10'>Tiny's Ring</font></b> \n\n Allows the hero to walk <b><font color='#eabe10'>through</font></b> units and trees. Enemies beneath the hero take damage every second based on his Agility. \n\n Model Size Reduction: 10% \n Radius: 100 \n Damage per Second: <b><font color='#eabe10'>110%</font></b> of Agility",
    "modifier_tiny_10_0": "Increase Tiny's Ring Radius: 50/100 \n\n Grants Unobstructed Vision: 400/800",
    "modifier_tiny_10_1": "Increase Tiny's Ring Radius: <b><font color='#eabe10'>50</font></b>/100 \n\n Grants Unobstructed Vision: <b><font color='#eabe10'>400</font></b>/800",
    "modifier_tiny_10_2": "Increase Tiny's Ring Radius: 50/<b><font color='#eabe10'>100</font></b> \n\n Grants Unobstructed Vision: 400/<b><font color='#eabe10'>800</font></b>",
