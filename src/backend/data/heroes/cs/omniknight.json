  "talents_description": {
    "modifier_omniknight_1_0": "After a 3-second delay, Purification triggers on allies again, but at 15%/30% of its normal strength.",
    "modifier_omniknight_1_1": "After a 3-second delay, Purification triggers on allies again, but at <b><font color='#eabe10'>15%</font></b>/30% of its normal strength.",
    "modifier_omniknight_1_2": "After a 3-second delay, Purification triggers on allies again, but at 15%/<b><font color='#eabe10'>30%</font></b> of its normal strength.",
    "modifier_omniknight_2_0": "Purification can be cast on an area. \n\n Purification Radius Increase: 50/100",
    "modifier_omniknight_2_1": "Purification can be cast on <b><font color='#eabe10'>an area</font></b>. \n\n Purification Radius Increase: <b><font color='#eabe10'>50</font></b>/100",
    "modifier_omniknight_2_2": "Purification can be cast on <b><font color='#eabe10'>an area</font></b>. \n\n Purification Radius Increase: 50/<b><font color='#eabe10'>100</font></b>",
    "modifier_omniknight_3_0": "Purification Cooldown Reduction: 1/2 sec.",
    "modifier_omniknight_3_1": "Purification Cooldown Reduction: <b><font color='#eabe10'>1</font></b>/2 sec.",
    "modifier_omniknight_3_2": "Purification Cooldown Reduction: 1/<b><font color='#eabe10'>2</font></b> sec.",
    "modifier_omniknight_4_0": "Increase Damage and Heal Purification: 30%/50%/70% of Strength",
    "modifier_omniknight_4_1": "Increase Damage and Heal Purification: <b><font color='#eabe10'>30%</font></b>/50%/70% of Strength",
    "modifier_omniknight_4_2": "Increase Damage and Heal Purification: 30%/<b><font color='#eabe10'>50%</font></b>/70% of Strength",
    "modifier_omniknight_4_3": "Increase Damage and Heal Purification: 30%/50%/<b><font color='#eabe10'>70%</font></b> of Strength",
    "modifier_omniknight_5_0": "<b><font color='#ff0000'>Repel no longer grants debuff immunity or magic resistance.</font></b> \n\n Repel becomes a Passive Ability. \n\n Repel Health Regen Increase: 10/20",
    "modifier_omniknight_5_1": "<b><font color='#ff0000'>Repel no longer grants debuff immunity or magic resistance.</font></b> \n\n Repel becomes a Passive Ability. \n\n Repel Health Regen Increase: <b><font color='#eabe10'>10</font></b>/20",
    "modifier_omniknight_5_2": "<b><font color='#ff0000'>Repel no longer grants debuff immunity or magic resistance.</font></b> \n\n Repel becomes a Passive Ability. \n\n Repel Health Regen Increase: 10/<b><font color='#eabe10'>20</font></b>",
    "modifier_omniknight_6_0": "Repel grants debuff immunity and magic resistance every 25/21 seconds.",
    "modifier_omniknight_6_1": "Repel grants debuff immunity and magic resistance every <b><font color='#eabe10'>25</font></b>/21 seconds.",
    "modifier_omniknight_6_2": "Repel grants debuff immunity and magic resistance every 25/<b><font color='#eabe10'>21</font></b> seconds.",
    "modifier_omniknight_7_0": "New Active Ability: Rain of Purification \n\n Creates multiple weakened Purification effects in a random area around the owner. \n\n Purification Interval: 0.25 sec. \n Purification Damage: 50% \n Duration: 5 sec. \n Radius: 900 \n Mana Cost: 400 \n Cooldown: 45 sec.",
    "modifier_omniknight_7_1": "New Active Ability: <b><font color='#eabe10'>Rain of Purification</font></b> \n\n Creates multiple weakened Purification effects in a random area around the owner. \n\n Purification Interval: 0.25 sec. \n Purification Damage: <b><font color='#eabe10'>50%</font></b> \n Duration: 5 sec. \n Radius: 900 \n Mana Cost: 400 \n Cooldown: 45 sec.",
    "modifier_omniknight_8_0": "Base Damage: 10/20/30",
    "modifier_omniknight_8_1": "Base Damage: <b><font color='#eabe10'>10</font></b>/20/30",
