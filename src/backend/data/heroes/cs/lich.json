  "talents_description": {
    "modifier_lich_1_0": "Sinister Gaze also procs on random enemies within a 600 radius: 1/2/3 \n\n Health: 70/140/210",
    "modifier_lich_1_1": "Sinister Gaze also procs on random enemies within a 600 radius: <b><font color='#eabe10'>1</font></b>/2/3 \n\n Health: <b><font color='#eabe10'>70</font></b>/140/210",
    "modifier_lich_1_2": "Sinister Gaze also procs on random enemies within a 600 radius: 1/<b><font color='#eabe10'>2</font></b>/3 \n\n Health: 70/<b><font color='#eabe10'>140</font></b>/210",
    "modifier_lich_1_3": "Sinister Gaze also procs on random enemies within a 600 radius: 1/2/<b><font color='#eabe10'>3</font></b> \n\n Health: 70/140/<b><font color='#eabe10'>210</font></b>",
    "modifier_lich_2_0": "Sinister Gaze deals damage per second to heroes: 150",
    "modifier_lich_2_1": "Sinister Gaze deals damage per second to heroes: <b><font color='#eabe10'>150</font></b>",
    "modifier_lich_3_0": "New Active Ability: Ice Spire \n\n Creates an Ice Spire at the target spot, slowing enemies around it. Can take 5 hero hits or 10 creep hits and when destroyed it will create a Frost Blast around it. Chain Frost can bounce to the Spire if there are no other enemies in range. Lich can cast Frost Shield on the Spire. Each Frost Shield tick will heal the spire by 1 hero attack. \n\n Movement Slow: 30% <bt> Radius: 750 \n Cooldown: 25 seconds \n Mana Cost: 150",
    "modifier_lich_3_1": "New Active Ability: <b><font color='#eabe10'>Ice Spire</font></b> \n\n Creates an Ice Spire at the target spot, slowing enemies around it. Can take 5 hero hits or 10 creep hits and when destroyed it will create a Frost Blast around it. Chain Frost can bounce to the Spire if there are no other enemies in range. Lich can cast Frost Shield on the Spire. Each Frost Shield tick will heal the spire by 1 hero attack. \n\n Movement Slow: <b><font color='#eabe10'>30%</font></b> <bt> Radius: 750 \n Cooldown: 25 seconds \n Mana Cost: 150",
    "modifier_lich_4_0": "Sinister Gaze Cooldown Reduction: 3/6 seconds",
    "modifier_lich_4_1": "Sinister Gaze Cooldown Reduction: <b><font color='#eabe10'>3</font></b>/6 seconds",
    "modifier_lich_4_2": "Sinister Gaze Cooldown Reduction: 3/<b><font color='#eabe10'>6</font></b> seconds",
    "modifier_lich_5_0": "Increases Chain Frost bounce damage: 2%/4%/6% of Max Health \n\n Increases Chain Frost bounce delay: 0.5/1/1.5 sec.",
    "modifier_lich_5_1": "Increases Chain Frost bounce damage: <b><font color='#eabe10'>2%</font></b>/4%/6% of Max Health \n\n Increases Chain Frost bounce delay: <b><font color='#eabe10'>0.5</font></b>/1/1.5 sec.",
    "modifier_lich_5_2": "Increases Chain Frost bounce damage: 2%/<b><font color='#eabe10'>4%</font></b>/6% of Max Health \n\n Increases Chain Frost bounce delay: 0.5/<b><font color='#eabe10'>1</font></b>/1.5 sec.",
    "modifier_lich_5_3": "Increases Chain Frost bounce damage: 2%/4%/<b><font color='#eabe10'>6%</font></b> of Max Health \n\n Increases Chain Frost bounce delay: 0.5/1/<b><font color='#eabe10'>1.5</font></b> sec.",
    "modifier_lich_6_0": "Increase Sinister Gaze Duration: 0.2/0.4/0.6 seconds",
    "modifier_lich_6_1": "Increase Sinister Gaze Duration: <b><font color='#eabe10'>0.2</font></b>/0.4/0.6 seconds",
    "modifier_lich_6_2": "Increase Sinister Gaze Duration: 0.2/<b><font color='#eabe10'>0.4</font></b>/0.6 seconds",
    "modifier_lich_6_3": "Increase Sinister Gaze Duration: 0.2/0.4/<b><font color='#eabe10'>0.6</font></b> seconds",
    "modifier_lich_7_0": "Chain Frost can be bounced off the hero. \n\n Chain Frost Cooldown Reduction: 35 seconds \n\n Increase Chain Frost Bounces: 7",
    "modifier_lich_7_1": "Chain Frost can be bounced off the <b><font color='#eabe10'>hero</font></b>. \n\n Chain Frost Cooldown Reduction: <b><font color='#eabe10'>35</font></b> seconds \n\n Increase Chain Frost Bounces: <b><font color='#eabe10'>7</font></b>",
    "modifier_lich_8_0": "<b><font color='#ff0000'>You cannot attack.</font></b> \n\n Frost Shield becomes a Passive Ability on the Hero. The damage dealt speed is affected by the Attack Speed. \n\n Adds 1 Level to Frost Shield.",
    "modifier_lich_8_1": "<b><font color='#ff0000'>You cannot attack.</font></b> \n\n Frost Shield becomes a <b><font color='#eabe10'>Passive Ability</font></b> on the Hero. The damage dealt speed is affected by the Attack Speed. \n\n Adds <b><font color='#eabe10'>1</font></b> Level to Frost Shield.",
    "modifier_lich_9_0": "Frost Shield deals Physical Damage, not Magic. \n\n Increase Frost Shield Damage: 8%/16%/24% of Attack Damage",
    "modifier_lich_9_1": "Frost Shield deals <b><font color='#eabe10'>Physical</font></b> Damage, not Magic. \n\n Increase Frost Shield Damage: <b><font color='#eabe10'>8%</font></b>/16%/24% of Attack Damage",
    "modifier_lich_9_2": "Frost Shield deals <b><font color='#eabe10'>Physical</font></b> Damage, not Magic. \n\n Increase Frost Shield Damage: 8%/<b><font color='#eabe10'>16%</font></b>/24% of Attack Damage",
    "modifier_lich_9_3": "Frost Shield deals <b><font color='#eabe10'>Physical</font></b> Damage, not Magic. \n\n Increase Frost Shield Damage: 8%/16%/<b><font color='#eabe10'>24%</font></b> of Attack Damage",
