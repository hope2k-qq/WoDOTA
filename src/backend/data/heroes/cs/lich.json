    "modifier_lich_18_1": "<b><font color='#ff0000'>Removes Sinister Gaze.</font></b> \n\n New Active Ability: <b><font color='#eabe10'>Frost Blast Line</font></b> \n\n Casts <b><font color='#eabe10'>Frost Blast</font></b> after a short delay along the line in front of the hero. \n\n Cast Range: 1400 \n\n Cooldown: 7 seconds \n Mana Cost: 140",
    "modifier_lich_19_0": "Casting Frost Blast, Frost Blast Ring, Frost Blast Line applies a stacking effect on the hero that increases Health Regeneration: 5/8/11 \n\n Effect Duration: 7 seconds \n\n Max Effects: 15",
    "modifier_lich_19_1": "Casting Frost Blast, Frost Blast Ring, Frost Blast Line applies a stacking effect on the hero that increases Health Regeneration: <b><font color='#eabe10'>5</font></b>/8/11 \n\n Effect Duration: 7 seconds \n\n Max Effects: 15",
    "modifier_lich_19_2": "Casting Frost Blast, Frost Blast Ring, Frost Blast Line applies a stacking effect on the hero that increases Health Regeneration: 5/<b><font color='#eabe10'>8</font></b>/11 \n\n Effect Duration: 7 seconds \n\n Max Effects: 15",
    "modifier_lich_19_3": "Casting Frost Blast, Frost Blast Ring, Frost Blast Line applies a stacking effect on the hero that increases Health Regeneration: 5/8/<b><font color='#eabe10'>11</font></b> \n\n Effect Duration: 7 seconds \n\n Max Effects: 15",
