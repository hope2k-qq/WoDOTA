  "talents_description": {
    "modifier_necrophos_1_0": "Heartstopper Aura deals damage to Creeps: 10% of Strength \n\nAlso works on Heroes if Necrophos has more than 300 Strength.",
    "modifier_necrophos_1_1": "Heartstopper Aura deals damage to Creeps: <b><font color='#eabe10'>10%</font></b> of Strength \n\nAlso works on Heroes if Necrophos has more than <b><font color='#eabe10'>300 Strength</font></b>.",
    "modifier_necrophos_2_0": "All Abilities consume Health, not Mana. \n\n Ghost Shroud Health Recovery Boost Increase: 10%/20%/30%",
    "modifier_necrophos_2_1": "All Abilities consume <b><font color='#eabe10'>Health</font></b>, not Mana. \n\n Ghost Shroud Health Recovery Boost Increase: <b><font color='#eabe10'>10%</font></b>/20%/30%",
    "modifier_necrophos_2_2": "All Abilities consume <b><font color='#eabe10'>Health</font></b>, not Mana. \n\n Ghost Shroud Health Recovery Boost Increase: 10%/<b><font color='#eabe10'>20%</font></b>/30%",
    "modifier_necrophos_2_3": "All Abilities consume <b><font color='#eabe10'>Health</font></b>, not Mana. \n\n Ghost Shroud Health Recovery Boost Increase: 10%/20%/<b><font color='#eabe10'>30%</font></b>",
    "modifier_necrophos_3_0": "Heartstopper Aura becomes a toggleable ability. \n\n When active, the hero takes damage from Heartstopper Aura and converts their Health Regeneration into Magical Damage from this ability.",
    "modifier_necrophos_3_1": "Heartstopper Aura becomes a toggleable ability. \n\n When active, the hero takes damage from Heartstopper Aura and converts their Health Regeneration into <b><font color='#eabe10'>Magical Damage</font></b> from this ability.",
    "modifier_necrophos_4_0": "Ghost Shroud increases Movement Speed per Enemy: 8%/16%/24% \n\n Strength: 4/8/12",
    "modifier_necrophos_4_1": "Ghost Shroud increases Movement Speed per Enemy: <b><font color='#eabe10'>8%</font></b>/16%/24% \n\n Strength: <b><font color='#eabe10'>4</font></b>/8/12",
    "modifier_necrophos_4_2": "Ghost Shroud increases Movement Speed per Enemy: 8%/<b><font color='#eabe10'>16%</font></b>/24% \n\n Strength: 4/<b><font color='#eabe10'>8</font></b>/12",
    "modifier_necrophos_4_3": "Ghost Shroud increases Movement Speed per Enemy: 8%/16%/<b><font color='#eabe10'>24%</font></b> \n\n Strength: 4/8/<b><font color='#eabe10'>12</font></b>",
    "modifier_necrophos_5_0": "Heartstopper Aura reduces Enemy Health Regeneration: 10%/20%",
    "modifier_necrophos_5_1": "Heartstopper Aura reduces Enemy Health Regeneration: <b><font color='#eabe10'>10%</font></b>/20%",
    "modifier_necrophos_5_2": "Heartstopper Aura reduces Enemy Health Regeneration: 10%/<b><font color='#eabe10'>20%</font></b>",
    "modifier_necrophos_6_0": "Heartstopper Aura Damage Increase: 0.1%/0.2%/0.3%",
    "modifier_necrophos_6_1": "Heartstopper Aura Damage Increase: <b><font color='#eabe10'>0.1%</font></b>/0.2%/0.3%",
    "modifier_necrophos_6_2": "Heartstopper Aura Damage Increase: 0.1%/<b><font color='#eabe10'>0.2%</font></b>/0.3%",
    "modifier_necrophos_6_3": "Heartstopper Aura Damage Increase: 0.1%/0.2%/<b><font color='#eabe10'>0.3%</font></b>",
    "modifier_necrophos_7_0": "<b><font color='#ff0000'>Removes Reaper's Scythe. </font></b> \n\n Heartstopper Aura deals Pure Damage rather than Magic Damage.",
    "modifier_necrophos_7_1": "<b><font color='#ff0000'>Removes Reaper's Scythe. </font></b> \n\n Heartstopper Aura deals <b><font color='#eabe10'>Pure Damage</font></b> rather than Magic Damage.",
    "modifier_necrophos_8_0": "Death Pulse deals Physical Damage, not Magical Damage. \n\n Death Pulse Cooldown Reduction: 0.5/1 sec.",
    "modifier_necrophos_8_1": "Death Pulse deals <b><font color='#eabe10'>Physical Damage</font></b>, not Magical Damage. \n\n Death Pulse Cooldown Reduction: <b><font color='#eabe10'>0.5</font></b>/1 sec.",
    "modifier_necrophos_8_2": "Death Pulse deals <b><font color='#eabe10'>Physical Damage</font></b>, not Magical Damage. \n\n Death Pulse Cooldown Reduction: 0.5/<b><font color='#eabe10'>1</font></b> sec.",
