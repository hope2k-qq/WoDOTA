  "talents_description": {
    "modifier_spectre_1_0": "Strength, Agility: 4/8/12",
    "modifier_spectre_1_1": "Strength, Agility: <b><font color='#eabe10'>4</font></b>/8/12",
    "modifier_spectre_1_2": "Strength, Agility: 4/<b><font color='#eabe10'>8</font></b>/12",
    "modifier_spectre_1_3": "Strength, Agility: 4/8/<b><font color='#eabe10'>12</font></b>",
    "modifier_spectre_2_0": "Health and Mana Regeneration: 3/6",
    "modifier_spectre_2_1": "Health and Mana Regeneration: <b><font color='#eabe10'>3</font></b>/6",
    "modifier_spectre_2_2": "Health and Mana Regeneration: 3/<b><font color='#eabe10'>6</font></b>",
    "modifier_spectre_3_0": "Dispersion can be pressed to taunt enemies within a 250/500 radius for 1.75 seconds. \n\n Cooldown: 18 seconds",
    "modifier_spectre_3_1": "Dispersion can be pressed to taunt enemies within a <b><font color='#eabe10'>250</font></b>/500 radius for <b><font color='#eabe10'>1.75</font></b> seconds. \n\n Cooldown: 18 seconds",
    "modifier_spectre_3_2": "Dispersion can be pressed to taunt enemies within a 250/<b><font color='#eabe10'>500</font></b> radius for <b><font color='#eabe10'>1.75</font></b> seconds. \n\n Cooldown: 18 seconds",
    "modifier_spectre_4_0": "Increases Dispersion Taunt Duration by 1% for every 1% of Missing Health.",
    "modifier_spectre_4_1": "Increases Dispersion Taunt Duration by <b><font color='#eabe10'>1%</font></b> for every <b><font color='#eabe10'>1% of Missing Health</font></b>.",
    "modifier_spectre_5_0": "New Passive Ability: Spectre Weakness \n\n Weakens enemies in an area with a radius of 600, causing them to take increased spell damage. \n\n Ability Damage Amplification: 5%/10%/15%",
    "modifier_spectre_5_1": "New Passive Ability: <b><font color='#eabe10'>Spectre Weakness</font></b> \n\n Weakens enemies in an area with a radius of 600, causing them to take increased spell damage. \n\n Ability Damage Amplification: <b><font color='#eabe10'>5%</font></b>/10%/15%",
    "modifier_spectre_5_2": "New Passive Ability: <b><font color='#eabe10'>Spectre Weakness</font></b> \n\n Weakens enemies in an area with a radius of 600, causing them to take increased spell damage. \n\n Ability Damage Amplification: 5%/<b><font color='#eabe10'>10%</font></b>/15%",
    "modifier_spectre_5_3": "New Passive Ability: <b><font color='#eabe10'>Spectre Weakness</font></b> \n\n Weakens enemies in an area with a radius of 600, causing them to take increased spell damage. \n\n Ability Damage Amplification: 5%/10%/<b><font color='#eabe10'>15%</font></b>",
    "modifier_spectre_6_0": "Attack Speed: 15/30 \n\n Spectre deals 2x damage with Desolate. Spectre's illusions no longer have Desolate.",
    "modifier_spectre_6_1": "Attack Speed: <b><font color='#eabe10'>15</font></b>/30 \n\n Spectre deals <b><font color='#eabe10'>2x</font></b> damage with Desolate. Spectre's illusions no longer have Desolate.",
    "modifier_spectre_6_2": "Attack Speed: 15/<b><font color='#eabe10'>30</font></b> \n\n Spectre deals <b><font color='#eabe10'>2x</font></b> damage with Desolate. Spectre's illusions no longer have Desolate.",
    "modifier_spectre_7_0": "Dispersion Reflected Damage Increase: 5%",
    "modifier_spectre_7_1": "Dispersion Reflected Damage Increase: <b><font color='#eabe10'>5%</font></b>",
    "modifier_spectre_8_0": "Removes the restriction on allies from Desolate. \n\n Desolate's additional Damage is distributed evenly between enemies within a 400 radius.",
    "modifier_spectre_8_1": "Removes <b><font color='#eabe10'>the restriction on allies</font></b> from Desolate. \n\n Desolate's additional Damage is <b><font color='#eabe10'>distributed evenly</font></b> between enemies within a 400 radius.",
    "modifier_spectre_9_0": "Increased Movement Speed Change from Shadow Path: 3%/6% \n\n Allows you to walk through units.",
    "modifier_spectre_9_1": "Increased Movement Speed Change from Shadow Path: <b><font color='#eabe10'>3%</font></b>/6% \n\n Allows you to walk <b><font color='#eabe10'>through</font></b> units.",
    "modifier_spectre_9_2": "Increased Movement Speed Change from Shadow Path: 3%/<b><font color='#eabe10'>6%</font></b> \n\n Allows you to walk <b><font color='#eabe10'>through</font></b> units.",
